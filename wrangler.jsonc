{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "contaai",
  "main": "./cloud/sync-worker.js",
  "compatibility_date": "2026-09-10",
  "vars": {
    "ALLOWED_ORIGINS": "*"
  },
  "assets": {
    "directory": ".dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "VAULTS",
        "class_name": "SyncVault"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SyncVault"]
    }
  ]
}
